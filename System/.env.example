# Copy this file to `.env` and adjust the values for your environment.
# `.env` is gitignored; never commit real secrets.
#
# Two deployment targets share this file:
#   - dev laptops      → use docker-compose.yml      (main-server)
#   - team VPS         → use docker-compose.vps.yml  (mysql + ml-server)
# Vars not used by your target are ignored.

# === Shared (must match between the VPS .env and every laptop .env) ===

# Public IP / hostname of the VPS hosting MySQL and the ML server.
DB_HOST=159.195.147.132
DB_PORT=3306
DB_NAME=kamtjatka
DB_USER=kamtjatka

# Strong password for DB_USER. Generate with:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
DB_PASSWORD=???

# Optional: override MainServer Jwt:Key (appsettings has a team default for VPS/laptops).
# JWT_KEY=

# === Laptop dev only (docker-compose.yml) ===

MAIN_SERVER_PORT=8080
FRONTEND_PORT=5173
ASPNETCORE_ENVIRONMENT=Development
ML_SERVER_URL=http://159.195.147.132:8000
MQTT_BROKER_HOST=159.195.147.132
MQTT_BROKER_PORT=1883

# === VPS only (docker-compose.vps.yml) ===

# Root password for MySQL. Internal — never shared with laptops.
MYSQL_ROOT_PASSWORD=???

# Public port for the ML server.
ML_SERVER_PORT=8000
