### Targets the main server deployed on the VPS (CI/CD-managed).
@host = http://159.195.147.132:8080

### Normal reading — should classify as Normal/Low
POST {{host}}/api/readings
Content-Type: application/json

{
  "sensorId": 101,
  "timestamp": "2026-04-08T12:15:00Z",
  "sensors": {
    "temperature": 24.5,
    "humidity": 45.2,
    "co2Level": 503,
    "tvoc": 28,
    "eco2": 410,
    "aqi": 1
  },
  "classification": "Normal"
}

### Cooking reading — warm + humid kitchen with elevated TVOC/eCO2 should classify as Cooking/Medium
POST {{host}}/api/readings
Content-Type: application/json

{
  "sensorId": 102,
  "timestamp": "2026-04-08T12:15:30Z",
  "sensors": {
    "temperature": 28,
    "humidity": 60,
    "co2Level": 1200,
    "tvoc": 800,
    "eco2": 1200,
    "aqi": 3
  },
  "classification": "Cooking"
}

### Fire reading — hot, very dry, very high eCO2 should classify as Fire/High
POST {{host}}/api/readings
Content-Type: application/json

{
  "sensorId": 101,
  "timestamp": "2026-04-08T12:16:00Z",
  "sensors": {
    "temperature": 38,
    "humidity": 15,
    "co2Level": 2500,
    "tvoc": 1000,
    "eco2": 8000,
    "aqi": 5
  },
  "classification": "Fire"
}

### Get latest 200 readings with their predictions (default limit)
GET {{host}}/api/readings

### Get latest readings for one device
GET {{host}}/api/readings?sensorId=101

### Get latest readings with a custom sample limit
GET {{host}}/api/readings?limit=500

### Get latest readings for one device with a custom sample limit
GET {{host}}/api/readings?sensorId=101&limit=100

### Get known sensor devices
GET {{host}}/api/readings/devices
