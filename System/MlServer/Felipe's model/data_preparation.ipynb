   "source": [
    "import json\n",
    "import re\n",
    "import os\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import openpyxl\n",
    "from openpyxl.styles import PatternFill, Font, Alignment, Border, Side\n",
    "from openpyxl.utils import get_column_letter\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ── Paths ────────────────────────────────────────────────────────────────────\n",
    "# All paths are relative to this notebook's location\n",
    "NOTEBOOK_DIR   = Path(os.getcwd())          # where this notebook lives\n",
    "IOT_DATA_DIR   = NOTEBOOK_DIR / \"Iot team data collected\"\n",
    "BLATTMANN_CSV  = NOTEBOOK_DIR / \"smoke_detection_iot.csv\"\n",
    "\n",
    "OUT_IOT        = NOTEBOOK_DIR / \"iot_data.xlsx\"\n",
    "OUT_BLATT_RAW  = NOTEBOOK_DIR / \"blattmann_raw.xlsx\"\n",
    "OUT_BLATT_PROC = NOTEBOOK_DIR / \"blattmann_processed.xlsx\"\n",
    "\n",
    "print(f\"Notebook directory : {NOTEBOOK_DIR}\")\n",
    "print(f\"IoT data directory : {IOT_DATA_DIR}  — exists: {IOT_DATA_DIR.exists()}\")\n",
    "print(f\"Blattmann CSV      : {BLATTMANN_CSV} — exists: {BLATTMANN_CSV.exists()}\")"
   ]
  },
