   ],
   "source": [
    "# ── Export IoT data to xlsx ────────────────────────────────────────────────────\n",
    "CLASS_COLORS = {\n",
    "    \"No Smoke\": \"D9EAD3\",   # light green\n",
    "    \"Smoke\":    \"FCE5CD\",   # light orange\n",
    "    \"Steam\":    \"CFE2F3\",   # light blue\n",
    "}\n",
    "\n",
    "wb = openpyxl.Workbook()\n",
    "\n",
    "# ── Sheet 1: Full data ────────────────────────────────────────────────────────\n",
    "ws_data = wb.active\n",
    "ws_data.title = \"IoT Data\"\n",
    "\n",
    "headers = list(iot_df.columns)\n",
    "header_fill = PatternFill(\"solid\", fgColor=\"1F4E79\")\n",
    "header_font = Font(bold=True, color=\"FFFFFF\")\n",
    "\n",
    "for col_idx, col_name in enumerate(headers, start=1):\n",
    "    cell = ws_data.cell(row=1, column=col_idx, value=col_name)\n",
    "    cell.fill   = header_fill\n",
    "    cell.font   = header_font\n",
    "    cell.alignment = Alignment(horizontal=\"center\")\n",
    "\n",
    "for row_idx, row_data in enumerate(iot_df.itertuples(index=False), start=2):\n",
    "    label = row_data.label\n",
    "    row_fill = PatternFill(\"solid\", fgColor=CLASS_COLORS.get(label, \"FFFFFF\"))\n",
    "    for col_idx, value in enumerate(row_data, start=1):\n",
    "        cell = ws_data.cell(row=row_idx, column=col_idx, value=value)\n",
    "        cell.fill = row_fill\n",
    "\n",
    "# Auto-fit column widths\n",
    "for col_idx, col_name in enumerate(headers, start=1):\n",
    "    max_len = max(len(str(col_name)), iot_df.iloc[:, col_idx-1].astype(str).map(len).max())\n",
    "    ws_data.column_dimensions[get_column_letter(col_idx)].width = min(max_len + 3, 50)\n",
    "\n",
    "# ── Sheet 2: Summary stats ────────────────────────────────────────────────────\n",
    "ws_summary = wb.create_sheet(\"Summary\")\n",
    "summary_df = iot_df.groupby(\"label\")[[\"temperature\",\"humidity\",\"co2_ppm\",\"tvoc_ppb\",\"eco2_ppm\"]].agg([\"mean\",\"min\",\"max\"]).round(2)\n",
    "summary_df.columns = [\"_\".join(c) for c in summary_df.columns]\n",
    "summary_df = summary_df.reset_index()\n",
    "\n",
    "for col_idx, col_name in enumerate(summary_df.columns, start=1):\n",
    "    cell = ws_summary.cell(row=1, column=col_idx, value=col_name)\n",
    "    cell.fill = header_fill\n",
    "    cell.font = header_font\n",
    "    cell.alignment = Alignment(horizontal=\"center\")\n",
    "\n",
    "for row_idx, row_data in enumerate(summary_df.itertuples(index=False), start=2):\n",
    "    label = row_data.label\n",
    "    row_fill = PatternFill(\"solid\", fgColor=CLASS_COLORS.get(label, \"FFFFFF\"))\n",
    "    for col_idx, value in enumerate(row_data, start=1):\n",
    "        cell = ws_summary.cell(row=row_idx, column=col_idx, value=value)\n",
    "        cell.fill = row_fill\n",
    "\n",
    "for col_idx in range(1, len(summary_df.columns) + 1):\n",
    "    ws_summary.column_dimensions[get_column_letter(col_idx)].width = 18\n",
    "\n",
    "# ── Sheet 3: Class distribution ───────────────────────────────────────────────\n",
    "ws_dist = wb.create_sheet(\"Class Distribution\")\n",
    "ws_dist.cell(row=1, column=1, value=\"label\").fill   = header_fill\n",
    "ws_dist.cell(row=1, column=1).font                  = header_font\n",
    "ws_dist.cell(row=1, column=2, value=\"count\").fill   = header_fill\n",
    "ws_dist.cell(row=1, column=2).font                  = header_font\n",
    "ws_dist.cell(row=1, column=3, value=\"percent\").fill = header_fill\n",
    "ws_dist.cell(row=1, column=3).font                  = header_font\n",
    "\n",
    "counts = iot_df[\"label\"].value_counts()\n",
    "for row_idx, (lbl, cnt) in enumerate(counts.items(), start=2):\n",
    "    row_fill = PatternFill(\"solid\", fgColor=CLASS_COLORS.get(lbl, \"FFFFFF\"))\n",
    "    ws_dist.cell(row=row_idx, column=1, value=lbl).fill         = row_fill\n",
    "    ws_dist.cell(row=row_idx, column=2, value=int(cnt)).fill    = row_fill\n",
    "    ws_dist.cell(row=row_idx, column=3, value=f\"{100*cnt/len(iot_df):.1f}%\").fill = row_fill\n",
    "\n",
    "for col_idx in [1, 2, 3]:\n",
    "    ws_dist.column_dimensions[get_column_letter(col_idx)].width = 20\n",
    "\n",
    "wb.save(OUT_IOT)\n",
    "print(f\"Saved: {OUT_IOT}\")\n",
    "print(f\"  Sheets: IoT Data ({len(iot_df)} rows), Summary, Class Distribution\")"
   ]
  },
