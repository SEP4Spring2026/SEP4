   "source": [
    "---\n",
    "## Part 1 — IoT MQTT logs → `iot_data.xlsx`\n",
    "\n",
    "The IoT team's data arrives as MQTT publish logs. Each line contains a JSON payload:\n",
    "```\n",
    "[MQTT] Payload : {\"sensorId\":102,\"temperature\":21.8,\"humidity\":32.0,...}\n",
    "```\n",
    "We parse every file, assign a class label based on the scenario folder, and combine into one dataframe."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e5f6a7b8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  No smoke Data                                                →   94 records  label='No Smoke'\n",
      "  Cooking smoke data (5 minutes before event)                  →   59 records  label='No Smoke'\n",
      "  Cooking smoke data (during event)                            →  165 records  label='Smoke'\n",
      "  Cooking smoke data (right after event has happened, 5 minutes) →   83 records  label='Smoke'\n",
      "  Steam fog (data for preventing false alarms, 5 minutes before event) →   67 records  label='No Smoke'\n",
      "  Steam fog (during steaming)                                  →   81 records  label='Steam'\n",
      "\n",
      "Total IoT records: 549\n",
      "label\n",
      "Smoke       248\n",
      "No Smoke    220\n",
      "Steam        81\n"
     ]
    }
   ],
   "source": [
    "# ── Scenario → label mapping ──────────────────────────────────────────────────\n",
    "# Rationale for each label assignment:\n",
    "#   - \"5 min before\" readings are indistinguishable from normal baseline → class 0\n",
    "#   - \"5 min after cooking\" still has elevated TVOC (mean 188 ppb) → class 1\n",
    "#   - \"5 min before steam\" is normal ambient → class 0\n",
    "\n",
    "SCENARIO_MAP = {\n",
    "    \"No smoke Data\": {\n",
    "        \"label\": \"No Smoke\",\n",
    "        \"class_id\": 0,\n",
    "        \"file\": \"message.txt\"\n",
    "    },\n",
    "    \"Cooking smoke data (5 minutes before event)\": {\n",
    "        \"label\": \"No Smoke\",\n",
    "        \"class_id\": 0,\n",
    "        \"file\": \"message (1).txt\"\n",
    "    },\n",
    "    \"Cooking smoke data (during event)\": {\n",
    "        \"label\": \"Smoke\",\n",
    "        \"class_id\": 1,\n",
    "        \"file\": \"message (2).txt\"\n",
    "    },\n",
    "    \"Cooking smoke data (right after event has happened, 5 minutes)\": {\n",
    "        \"label\": \"Smoke\",\n",
    "        \"class_id\": 1,\n",
    "        \"file\": \"message (3).txt\"\n",
    "    },\n",
    "    \"Steam fog (data for preventing false alarms, 5 minutes before event)\": {\n",
    "        \"label\": \"No Smoke\",\n",
    "        \"class_id\": 0,\n",
    "        \"file\": \"message (4).txt\"\n",
    "    },\n",
    "    \"Steam fog (during steaming)\": {\n",
    "        \"label\": \"Steam\",\n",
    "        \"class_id\": 2,\n",
    "        \"file\": \"message (5).txt\"\n",
    "    },\n",
    "}\n",
    "\n",
    "def parse_mqtt_log(filepath: Path) -> list[dict]:\n",
    "    \"\"\"Extract JSON payloads from an MQTT publish log file.\"\"\"\n",
    "    with open(filepath, encoding=\"utf-8\", errors=\"ignore\") as f:\n",
    "        content = f.read()\n",
    "    payloads = re.findall(r'\\[MQTT\\] Payload\\s+: (\\{.*?\\})', content)\n",
    "    records = []\n",
    "    for p in payloads:\n",
    "        try:\n",
    "            records.append(json.loads(p))\n",
    "        except json.JSONDecodeError:\n",
    "            pass\n",
    "    return records\n",
    "\n",
    "# ── Parse all files ───────────────────────────────────────────────────────────\n",
    "rows = []\n",
    "for scenario_folder, meta in SCENARIO_MAP.items():\n",
    "    log_path = IOT_DATA_DIR / scenario_folder / meta[\"file\"]\n",
    "    if not log_path.exists():\n",
    "        print(f\"  WARNING: file not found — {log_path}\")\n",
    "        continue\n",
    "    records = parse_mqtt_log(log_path)\n",
    "    for r in records:\n",
    "        rows.append({\n",
    "            \"scenario\":    scenario_folder,\n",
    "            \"temperature\": r.get(\"temperature\"),\n",
    "            \"humidity\":    r.get(\"humidity\"),\n",
    "            \"co2_ppm\":     r.get(\"co2Level\"),\n",
    "            \"tvoc_ppb\":    r.get(\"tvoc\"),\n",
    "            \"eco2_ppm\":    r.get(\"eco2\"),\n",
    "            \"aqi\":         r.get(\"aqi\"),\n",
    "            \"label\":       meta[\"label\"],\n",
    "            \"class_id\":    meta[\"class_id\"],\n",
    "        })\n",
    "    print(f\"  {scenario_folder:<60} → {len(records):>4} records  label='{meta['label']}'\")\n",
    "\n",
    "iot_df = pd.DataFrame(rows)\n",
    "print(f\"\\nTotal IoT records: {len(iot_df)}\")\n",
    "print(iot_df[\"label\"].value_counts().to_string())"
   ]
  },
