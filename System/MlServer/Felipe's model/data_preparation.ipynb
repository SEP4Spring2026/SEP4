    "import zipfile\n",
    "\n",
    "# ── Auto-unzip archive.zip if CSV not yet extracted ───────────────────────────\n",
    "if not BLATTMANN_CSV.exists():\n",
    "    zip_candidates = [\n",
    "        NOTEBOOK_DIR / \"archive.zip\",\n",
    "        NOTEBOOK_DIR / \"smoke-detection-dataset.zip\",\n",
    "    ]\n",
    "    found_zip = next((z for z in zip_candidates if z.exists()), None)\n",
    "\n",
    "    if found_zip is None:\n",
    "        raise FileNotFoundError(\n",
    "            f\"\\n\\nNeither the CSV nor a zip file was found in:\\n  {NOTEBOOK_DIR}\\n\\n\"\n",
    "            \"Download from: https://www.kaggle.com/datasets/deepcontractor/smoke-detection-dataset\\n\"\n",
    "            \"Place archive.zip in this folder and re-run this cell.\\n\"\n",
    "        )\n",
    "\n",
    "    print(f\"Extracting {found_zip.name} ...\")\n",
    "    with zipfile.ZipFile(found_zip) as z:\n",
    "        csv_members = [m for m in z.namelist() if m.endswith('.csv')]\n",
    "        if not csv_members:\n",
    "            raise ValueError(f\"No CSV file found inside {found_zip.name}\")\n",
    "        with z.open(csv_members[0]) as src, open(BLATTMANN_CSV, 'wb') as dst:\n",
    "            dst.write(src.read())\n",
